{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "kubernetes-mcp-server@latest"],
      "enabled": true
    },
    "aspire-dashboard": {
        "type": "remote",
        "url": "http://localhost:18891",
        "enabled": false
    },
    "anchor": {
        "type": "remote",
        "url": "http://localhost:42777/mcp",
        "enabled": false,
        "_comment": "Anchor semantic memory MCP server — enable if running Anchor locally"
    },
    "wayofteams": {
        "type": "remote",
        "url": "https://teamsapp.zerwiz.org/mcp",
        "enabled": false,
        "_comment": "WayOfTeams MCP — 41 tools. Requires paid subscription. Enable after GitHub login."
    }
  }
}
