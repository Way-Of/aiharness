{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "kubernetes-mcp-server@latest"],
      "enabled": true
    },
    "aspire-dashboard": {
        "type": "remote",
        "url": "http://localhost:18891",
        "enabled": false
    },
    "anchor": {
        "type": "remote",
        "url": "http://localhost:42777/mcp",
        "enabled": false,
        "_comment": "Anchor semantic memory MCP server — enable if running Anchor locally"
    },
    "wayofteams": {
        "type": "remote",
        "url": "http://localhost:4000/mcp",
        "enabled": false,
        "_comment": "WayOfTeams CTO Dashboard MCP — enable if running WayOfTeams locally (25+ tools: tickets, standups, knowledge, rules, memory)"
    }
  }
}
